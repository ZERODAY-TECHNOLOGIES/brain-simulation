<UserControl x:Class="BrainSim.App.Views.EffectorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BrainSim.App.Controls">
  <ScrollViewer Background="{StaticResource SurfaceBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="12,6">
      <TextBlock Text="E2 sampling, applied once per reply" Style="{StaticResource SectionTitle}" />
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Next reply would use" Style="{StaticResource Muted}" Width="150" />
        <TextBlock Text="{Binding SamplingText}" Style="{StaticResource Number}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
        <TextBlock Text="Last reply used" Style="{StaticResource Muted}" Width="150" />
        <TextBlock Text="{Binding LastSamplingText}" Style="{StaticResource Number}" />
      </StackPanel>

      <TextBlock Text="E1 steering, sent as a mood note in the system prompt (D-38)" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Next reply would get" Style="{StaticResource Muted}" />
        <TextBlock Grid.Column="1" x:Name="MoodNext" Text="{Binding MoodText}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="1" Text="Last reply got" Style="{StaticResource Muted}" Margin="0,4,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MoodLast" Text="{Binding LastMoodText}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0" />
      </Grid>

      <TextBlock Text="CB1 brake on release" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="CB1 tone" Style="{StaticResource Muted}" Width="150" />
        <TextBlock Text="{Binding Cb1Text}" Style="{StaticResource Number}" />
      </StackPanel>

      <TextBlock Text="Modulation channels (m_k)" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
      <ItemsControl ItemsSource="{Binding Channels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" />
              <c:BipolarBar Grid.Column="1" Height="8" Value="{Binding Value}" Range="0.5" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat=+0.000;-0.000;0.000}" Style="{StaticResource Number}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="{Binding Note}" Style="{StaticResource Muted}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
