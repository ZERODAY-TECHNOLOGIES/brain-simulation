<UserControl x:Class="BrainSim.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:BrainSim.App">
  <Grid Background="{StaticResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="10">
      <ItemsControl x:Name="Items" ItemsSource="{Binding Chat}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Bubble" CornerRadius="6" Padding="10,8" Margin="0,0,40,8" Background="#18202B">
              <StackPanel>
                <TextBlock app:MarkdownText.Markdown="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           FontFamily="{StaticResource NumberFont}" Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsUser}" Value="True">
                <Setter TargetName="Bubble" Property="Background" Value="#1F2A36" />
                <Setter TargetName="Bubble" Property="Margin" Value="40,0,0,8" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter TargetName="Bubble" Property="Background" Value="#3A2A10" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="10" IsEnabled="{Binding CanEdit}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Padding="16,4" Command="{Binding SendCommand}" />
    </Grid>
  </Grid>
</UserControl>
