<UserControl x:Class="BrainSim.App.Views.DreamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:BrainSim.App">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>

  <ScrollViewer Background="{StaticResource SurfaceBrush}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12,6">
      <!-- The dream in progress, revealed at one token per 2 seconds of REM. -->
      <Border Visibility="{Binding Dreaming, Converter={StaticResource Visible}}" Background="#1A1530" CornerRadius="6" Padding="10,8" Margin="0,4,0,10">
        <StackPanel>
          <TextBlock Text="Dreaming now" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
          <TextBlock Text="{Binding CurrentDreamSeeds}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
          <TextBlock app:MarkdownText.Markdown="{Binding CurrentDream}" Foreground="#C7D2FE" TextWrapping="Wrap" FontStyle="Italic" />
        </StackPanel>
      </Border>

      <TextBlock Text="Dream journal" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding DreamsEmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" x:Name="Empty" />
      <ItemsControl ItemsSource="{Binding Dreams}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6,0,8">
              <StackPanel>
                <WrapPanel>
                  <TextBlock Text="{Binding When}" Style="{StaticResource Number}" Margin="0,0,14,0" />
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontFamily="{StaticResource NumberFont}" />
                </WrapPanel>
                <TextBlock Text="{Binding Seeds}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,3" />
                <TextBlock app:MarkdownText.Markdown="{Binding Text}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" FontStyle="Italic" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
