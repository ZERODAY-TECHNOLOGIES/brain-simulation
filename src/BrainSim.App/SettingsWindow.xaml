<Window x:Class="BrainSim.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="620" Height="560" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="LLM backend" Style="{StaticResource SectionTitle}" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,12"
                   Text="Any OpenAI-compatible server: LM Studio, Ollama, llama.cpp, vLLM or a hosted API. Changes apply when BrainSim restarts." />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="Margin" Value="0,4,12,4" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style TargetType="TextBox">
              <Setter Property="Margin" Value="0,4" />
            </Style>
          </Grid.Resources>

          <TextBlock Text="Chat preset" />
          <ComboBox x:Name="ChatPresetBox" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" MinWidth="180"
                    AutomationProperties.Name="Chat preset" SelectionChanged="OnChatPreset"
                    ToolTip="Fills in the usual address of a vendor. Everything stays editable." />

          <TextBlock Grid.Row="1" Text="Server address" />
          <TextBox x:Name="BaseUrl" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Server address" />

          <TextBlock Grid.Row="2" Text="API key" />
          <PasswordBox x:Name="ApiKey" Grid.Row="2" Grid.Column="1" Margin="0,4" AutomationProperties.Name="API key"
                       ToolTip="Only for hosted APIs. Sent only to this server. Stored encrypted for your Windows account." />

          <TextBlock Grid.Row="3" Text="Chat model" />
          <TextBox x:Name="ChatModel" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Chat model" />

          <TextBlock Grid.Row="4" Text="Embedding preset" Margin="0,16,12,4" />
          <ComboBox x:Name="EmbeddingPresetBox" Grid.Row="4" Grid.Column="1" Margin="0,16,0,4" HorizontalAlignment="Left" MinWidth="180"
                    AutomationProperties.Name="Embedding preset" SelectionChanged="OnEmbeddingPreset"
                    ToolTip="Fills in the embedding server, model and prefix. On the chat server itself the embedding server stays empty." />

          <TextBlock Grid.Row="5" Text="Embedding server" />
          <TextBox x:Name="EmbeddingUrl" Grid.Row="5" Grid.Column="1" AutomationProperties.Name="Embedding server"
                   ToolTip="Leave empty to use the server address above." />

          <TextBlock Grid.Row="6" Text="Embedding API key" />
          <PasswordBox x:Name="EmbeddingApiKey" Grid.Row="6" Grid.Column="1" Margin="0,4" AutomationProperties.Name="Embedding API key"
                       ToolTip="Used only with a separate embedding server; the API key above never goes to it. Stored encrypted for your Windows account." />

          <TextBlock Grid.Row="7" Text="Embedding model" />
          <TextBox x:Name="EmbeddingModel" Grid.Row="7" Grid.Column="1" AutomationProperties.Name="Embedding model" />

          <TextBlock Grid.Row="8" Text="Embedding prefix" />
          <TextBox x:Name="EmbeddingPrefix" Grid.Row="8" Grid.Column="1" AutomationProperties.Name="Embedding prefix" />
        </Grid>

        <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="Changing the embedding model or prefix turns the appraisal probes off until they are retrained (tools/ProbeTrainer), and facts already in memory will no longer be recalled reliably." />

        <TextBlock x:Name="Status" Style="{StaticResource Number}" TextWrapping="Wrap" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Defaults" Padding="12,2" Margin="0,0,8,0" Click="OnDefaults" ToolTip="Fill in the values from config.yaml" />
      <Button x:Name="TestButton" Content="Test connection" Padding="12,2" Margin="0,0,24,0" Click="OnTest" />
      <Button Content="Save" Padding="12,2" Margin="0,0,8,0" Click="OnSave" IsDefault="True" />
      <Button Content="Cancel" Padding="12,2" IsCancel="True" />
    </WrapPanel>
  </Grid>
</Window>
