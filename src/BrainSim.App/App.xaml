<Application x:Class="BrainSim.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F14" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121821" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1F2A36" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6EDF3" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8B98A5" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
    <FontFamily x:Key="NumberFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Number" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
  </Application.Resources>
</Application>
