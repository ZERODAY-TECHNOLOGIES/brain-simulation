<Window x:Class="HelixSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Helix spike" Width="1280" Height="800" Background="#0B0F14">
  <Grid>
    <hx:Viewport3DX x:Name="Viewport"
                    BackgroundColor="#0B0F14"
                    ShowFrameRate="True"
                    ShowTriangleCountInfo="True"
                    ShowViewCube="False"
                    ShowCoordinateSystem="False"
                    FXAALevel="Low" />
    <TextBlock x:Name="Stats" Margin="12" VerticalAlignment="Bottom" Foreground="#8B98A5" FontFamily="Cascadia Mono" />
  </Grid>
</Window>
